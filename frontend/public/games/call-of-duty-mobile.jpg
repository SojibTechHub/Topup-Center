<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 800" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0B0F19" />
      <stop offset="40%" stop-color="#1A1E2E" />
      <stop offset="100%" stop-color="#070A12" />
    </linearGradient>
    <linearGradient id="neon" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#F59E0B" />
      <stop offset="100%" stop-color="#EF4444" />
    </linearGradient>
    <linearGradient id="badge" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F59E0B" />
      <stop offset="100%" stop-color="#B45309" />
    </linearGradient>
  </defs>
  <rect width="600" height="800" fill="url(#bg)" />
  <circle cx="300" cy="340" r="180" fill="#F59E0B" opacity="0.12" filter="blur(40px)" />
  <!-- Skull / Tactical Emblem -->
  <g transform="translate(300, 320) scale(1.3)">
    <polygon points="0,-100 80,-40 80,60 0,110 -80,60 -80,-40" fill="none" stroke="url(#neon)" stroke-width="6" />
    <polygon points="0,-85 65,-35 65,50 0,95 -65,50 -65,-35" fill="#111827" stroke="#F59E0B" stroke-width="2" opacity="0.8" />
    <!-- Crosshairs -->
    <circle cx="0" cy="0" r="45" fill="none" stroke="#EF4444" stroke-width="4" stroke-dasharray="10 5" />
    <circle cx="0" cy="0" r="12" fill="#F59E0B" />
    <line x1="-60" y1="0" x2="60" y2="0" stroke="#F59E0B" stroke-width="3" />
    <line x1="0" y1="-60" x2="0" y2="60" stroke="#F59E0B" stroke-width="3" />
  </g>
  <!-- Text -->
  <text x="300" y="550" font-family="'Space Grotesk', system-ui, sans-serif" font-size="44" font-weight="900" fill="#FFFFFF" text-anchor="middle" letter-spacing="3">CALL OF DUTY</text>
  <text x="300" y="600" font-family="'Space Grotesk', system-ui, sans-serif" font-size="32" font-weight="800" fill="#F59E0B" text-anchor="middle" letter-spacing="6">MOBILE CP</text>
  <rect x="220" y="640" width="160" height="38" rx="19" fill="url(#badge)" />
  <text x="300" y="665" font-family="'Hind Siliguri', sans-serif" font-size="16" font-weight="700" fill="#FFFFFF" text-anchor="middle">ইনস্ট্যান্ট CP টপআপ</text>
</svg>