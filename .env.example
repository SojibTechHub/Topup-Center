# Topup Center Environment Variables
# Copy this to .env.local and fill in your values

# ─── App ────────────────────────────────────────
APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Database (Neon PostgreSQL) ─────────────────
# Pooled connection (for Prisma Client)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require&pgbouncer=true&connection_limit=10
# Direct connection (for migrations)
DIRECT_URL=postgresql://user:password@host/db?sslmode=require

# ─── Auth.js ────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=your_secret_here
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ─── Google OAuth (optional) ────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── UddoktaPay ─────────────────────────────────
UDDOKTAPAY_BASE_URL=https://sandbox.uddoktapay.com
UDDOKTAPAY_API_KEY=your_uddoktapay_api_key

# ─── Upstash Redis ──────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# ─── Resend (Email) ─────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Topup Center <support@example.com>

# ─── Telegram Bot (Admin Alerts) ────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ─── Vercel Blob (File Uploads) ─────────────────
BLOB_READ_WRITE_TOKEN=

# ─── Cron Security ──────────────────────────────
# Generate: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# ─── Encryption ─────────────────────────────────
# 64 hex chars (32 bytes): openssl rand -hex 32
ENCRYPTION_KEY=your_64_char_hex_key_here

# ─── AI Key Pool ────────────────────────────────
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GROK_API_KEY_1=
GROK_API_KEY_2=
GROK_API_KEY_3=
GROK_API_KEY_4=
GEMINI_MODEL=gemini-2.5-flash
GROK_MODEL=grok-4
AI_PRIMARY=gemini

# ─── Feature Flags ──────────────────────────────
FEATURE_AI=true
FEATURE_REFERRAL=true
FEATURE_REVIEWS=true
FEATURE_GIFT_TOPUP=true
FEATURE_MANUAL_TOPUP=true

# ─── Business Settings ──────────────────────────
SUPPLIER_MODE=MANUAL

# ─── Monitoring ─────────────────────────────────
SENTRY_DSN=
