<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 800" width="100%" height="100%">
  <defs>
    <linearGradient id="vbg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0F1923" />
      <stop offset="50%" stop-color="#1B2733" />
      <stop offset="100%" stop-color="#070A12" />
    </linearGradient>
    <linearGradient id="vred" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FF4655" />
      <stop offset="100%" stop-color="#DC2626" />
    </linearGradient>
  </defs>
  <rect width="600" height="800" fill="url(#vbg)" />
  <circle cx="300" cy="340" r="190" fill="#FF4655" opacity="0.15" filter="blur(50px)" />
  <!-- Valorant V Icon -->
  <g transform="translate(300, 310) scale(1.4)">
    <polygon points="-50,-80 -10,-80 50,60 10,60" fill="url(#vred)" />
    <polygon points="50,-80 20,-80 -30,0 0,0" fill="#ECE8E1" />
  </g>
  <text x="300" y="550" font-family="'Space Grotesk', system-ui, sans-serif" font-size="52" font-weight="900" fill="#ECE8E1" text-anchor="middle" letter-spacing="4">VALORANT</text>
  <text x="300" y="600" font-family="'Space Grotesk', system-ui, sans-serif" font-size="28" font-weight="800" fill="#FF4655" text-anchor="middle" letter-spacing="6">RIOT POINTS (VP)</text>
  <rect x="220" y="640" width="160" height="38" rx="19" fill="url(#vred)" />
  <text x="300" y="665" font-family="'Hind Siliguri', sans-serif" font-size="16" font-weight="700" fill="#FFFFFF" text-anchor="middle">অটো VP ডেলিভারি</text>
</svg>
