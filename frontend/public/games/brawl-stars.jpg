<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 800" width="100%" height="100%">
  <defs>
    <linearGradient id="bsbg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1E1B4B" />
      <stop offset="50%" stop-color="#31104B" />
      <stop offset="100%" stop-color="#070A12" />
    </linearGradient>
    <linearGradient id="bsyellow" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FBBF24" />
      <stop offset="100%" stop-color="#F59E0B" />
    </linearGradient>
    <linearGradient id="bspurple" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#A855F7" />
      <stop offset="100%" stop-color="#7C3AED" />
    </linearGradient>
  </defs>
  <rect width="600" height="800" fill="url(#bsbg)" />
  <circle cx="300" cy="330" r="180" fill="#FBBF24" opacity="0.15" filter="blur(40px)" />
  <!-- Brawl Stars Skull Pin -->
  <g transform="translate(300, 320) scale(1.3)">
    <circle cx="0" cy="-10" r="75" fill="url(#bsyellow)" stroke="#000000" stroke-width="8" />
    <!-- Big Anime Eyes -->
    <ellipse cx="-25" cy="-20" rx="16" ry="24" fill="#000000" />
    <circle cx="-28" cy="-26" r="6" fill="#FFFFFF" />
    <ellipse cx="25" cy="-20" rx="16" ry="24" fill="#000000" />
    <circle cx="22" cy="-26" r="6" fill="#FFFFFF" />
    <!-- Wing bandage / emblem -->
    <polygon points="-40,25 0,15 40,25 0,40" fill="#EF4444" stroke="#000000" stroke-width="4" />
  </g>
  <text x="300" y="550" font-family="'Space Grotesk', system-ui, sans-serif" font-size="48" font-weight="900" fill="#FFFFFF" text-anchor="middle" letter-spacing="3">BRAWL STARS</text>
  <text x="300" y="600" font-family="'Space Grotesk', system-ui, sans-serif" font-size="28" font-weight="800" fill="#FBBF24" text-anchor="middle" letter-spacing="5">GEMS &amp; BRAWL PASS</text>
  <rect x="220" y="640" width="160" height="38" rx="19" fill="url(#bspurple)" />
  <text x="300" y="665" font-family="'Hind Siliguri', sans-serif" font-size="16" font-weight="700" fill="#FFFFFF" text-anchor="middle">সুপারসেল টপআপ</text>
</svg>