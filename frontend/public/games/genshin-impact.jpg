<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 800" width="100%" height="100%">
  <defs>
    <linearGradient id="gbg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#111827" />
      <stop offset="50%" stop-color="#1E1B4B" />
      <stop offset="100%" stop-color="#070A12" />
    </linearGradient>
    <linearGradient id="primogem" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FCD34D" />
      <stop offset="40%" stop-color="#F472B6" />
      <stop offset="100%" stop-color="#60A5FA" />
    </linearGradient>
  </defs>
  <rect width="600" height="800" fill="url(#gbg)" />
  <circle cx="300" cy="330" r="180" fill="#60A5FA" opacity="0.15" filter="blur(40px)" />
  <!-- Primogem / Star Icon -->
  <g transform="translate(300, 320) scale(1.3)">
    <polygon points="0,-100 25,-25 100,0 25,25 0,100 -25,25 -100,0 -25,-25" fill="url(#primogem)" />
    <polygon points="0,-70 18,-18 70,0 18,18 0,70 -18,18 -70,0 -18,-18" fill="#1E1B4B" opacity="0.6" />
    <circle cx="0" cy="0" r="15" fill="#FFFFFF" />
  </g>
  <text x="300" y="550" font-family="'Space Grotesk', system-ui, sans-serif" font-size="42" font-weight="900" fill="#FFFFFF" text-anchor="middle" letter-spacing="3">GENSHIN IMPACT</text>
  <text x="300" y="598" font-family="'Space Grotesk', system-ui, sans-serif" font-size="26" font-weight="700" fill="#93C5FD" text-anchor="middle" letter-spacing="4">CRYSTALS &amp; WELKIN</text>
  <rect x="210" y="640" width="180" height="38" rx="19" fill="#3B82F6" />
  <text x="300" y="665" font-family="'Hind Siliguri', sans-serif" font-size="16" font-weight="700" fill="#FFFFFF" text-anchor="middle">সরাসরি UID টপআপ</text>
</svg>